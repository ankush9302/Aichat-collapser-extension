{
  "manifest_version": 3,
  "name": "Chat Collapser",
  "version": "1.0.0",
  "description": "Collapse older message pairs in long AI chat threads on Claude.ai and ChatGPT.com",

  "permissions": [
    "storage"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Chat Collapser"
  }
}
